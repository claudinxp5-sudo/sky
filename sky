local function createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or TouchEnabled and 8 or 6)
    corner.Parent = parent
    return corner
end

local function createStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(100, 149, 237)
    stroke.Thickness = thickness or (TouchEnabled and 2 or 1)
    stroke.Parent = parent
    return stroke
end

local function playClickEffect(button)
    local originalSize = button.Size
    local clickEffect = button:Clone()
    clickEffect.Name = "ClickEffect"
    clickEffect.ZIndex = 10
    clickEffect.Visible = true
    clickEffect.Size = originalSize
    clickEffect.Position = UDim2.new(0.5, 0, 0.5, 0)
    clickEffect.AnchorPoint = Vector2.new(0.5, 0.5)
    clickEffect.BackgroundTransparency = 0.7
    clickEffect.TextTransparency = 0.7
    clickEffect.Parent = button.Parent

    if button:IsA("TextButton") then
        button.TextTransparency = 0
    end

    TweenService:Create(clickEffect, TweenInfo.new(0.2), {
        Size = originalSize * 1.3,
        BackgroundTransparency = 1
    }):Play()
    TweenService:Create(clickEffect, TweenInfo.new(0.2), {
        TextTransparency = 1
    }):Play()

    task.delay(0.2, function()
        clickEffect:Destroy()
    end)
end

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function setValue(name, value)
    states[name] = value
    if name == "walkSpeed" and getHumanoid() then
        getHumanoid().WalkSpeed = value
    elseif name == "jumpPower" and getHumanoid() then
        getHumanoid().JumpPower = value
    elseif name == "fullBright" then
        Lighting.Brightness = value and 4 or 1.5
    elseif name == "noclip" then
        local parts = getCharacter():GetDescendants()
        for _, v in ipairs(parts) do
            if v:IsA("BasePart") then
                v.CanCollide = not value
            end
        end
    elseif name == "aimAssist" and value then
        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not states.aimAssist then
                connection:Disconnect()
                return
            end
            local mousePos = Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
            local closest, closestDist = nil, math.huge
            for _, v in ipairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character then
                    local head = v.Character:FindFirstChild("Head")
                    if head then
                        local screenPos = Workspace.CurrentCamera:WorldToScreenPoint(head.Position)
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < closestDist and dist < states.aimRadius then
                            closest, closestDist = head, dist
                        end
                    end
                end
            end
            if closest then
                local humRoot = getHRP()
                if humRoot then
                    humRoot.CFrame = CFrame.lookAt(humRoot.Position, closest.Position)
                end
            end
        end)
        connections.aimAssist = connection
    elseif name == "glowPlayers" then
        local glowFolder = Workspace:FindFirstChild("SkyNetGlow")
        if value then
            glowFolder = Instance.new("Folder")
            glowFolder.Name = "SkyNetGlow"
            glowFolder.Parent = Workspace
            for _, v in ipairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character then
                    coroutine.wrap(function()
                        local glow
                        repeat
                            task.wait(0.2)
                            local head = v.Character:FindFirstChild("Head")
                            if head then
                                local distance = (head.Position - (getHRP() and getHRP().Position or Vector3.new())).Magnitude
                                if distance < states.highlightDistance then
                                    if not glow then
                                        glow = Instance.new("BoxHandleAdornment")
                                        glow.Adornee = head
                                        glow.Size = Vector3.new(4, 5, 4)
                                        glow.Color3 = Color3.new(1, 0.5, 0)
                                        glow.AlwaysOnTop = true
                                        glow.Transparency = 0.7
                                        glow.ZIndex = 5
                                        glow.Parent = glowFolder
                                    end
                                else
                                    if glow then
                                        glow:Destroy()
                                        glow = nil
                                    end
                                end
                            end
                        until not glow or not states.glowPlayers
                        if glow then glow:Destroy() end
                    end)()
                end
            end
        else
            if glowFolder then
                glowFolder:Destroy()
            end
        end
    elseif name == "fly" and value then
        local root = getHRP()
        if not root then return end

        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
        bodyGyro.D = 50
        bodyGyro.P = 1000
        bodyGyro.Parent = root

        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(400000, 0, 400000)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = root

        connections.flyGyro = bodyGyro
        connections.flyVelocity = bodyVelocity

        local flyConnection
        flyConnection = RunService.Stepped:Connect(function()
            if not states.fly or not root then
                flyConnection:Disconnect()
                if bodyGyro then bodyGyro:Destroy() end
                if bodyVelocity then bodyVelocity:Destroy() end
                return
            end

            local moveDirection = getHumanoid().MoveDirection
            local cameraCF = Workspace.CurrentCamera.CFrame
            local rightVector = cameraCF.RightVector
            local forwardVector = cameraCF.LookVector * Vector3.new(1, 0, 1).Unit

            local movement = (forwardVector * moveDirection.Z + rightVector * moveDirection.X)
            if movement.Magnitude > 0 then
                movement = movement.Unit * states.flySpeed
                bodyVelocity.Velocity = Vector3.new(movement.X, moveDirection.Y * states.flySpeed, movement.Z)
            else
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
        end)
        connections.flyConnection = flyConnection
    elseif name == "fly" and not value then
        if connections.flyGyro then
            connections.flyGyro:Destroy()
            connections.flyGyro = nil
        end
        if connections.flyVelocity then
            connections.flyVelocity:Destroy()
            connections.flyVelocity = nil
        end
        if connections.flyConnection then
            connections.flyConnection:Disconnect()
            connections.flyConnection = nil
        end
    elseif name == "teleportUp" and value then
        local hrp = getHRP()
        if hrp then
            hrp.CFrame = hrp.CFrame + Vector3.new(0, states.teleportDistance, 0)
        end
        states.teleportUp = false
    elseif name == "noFog" then
        Lighting.FogEnd = value and 100000 or 800
    end
end

local tabs = {}
local function createTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, TouchEnabled and 40 or 35)
    btn.Text = name
    btn.Font = TouchEnabled and Enum.Font.GothamBold or Enum.Font.SourceSansBold
    btn.TextSize = TouchEnabled and 16 or 13
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Parent = tabList
    createCorner(btn, TouchEnabled and 8 or 4)
    createStroke(btn)

    local page = Instance.new("Frame")
    page.Name = name.."Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = tabContent

    tabs[name] = page

    btn.MouseButton1Click:Connect(function()
        for _, v in pairs(tabs) do
            v.Visible = false
        end
        page.Visible = true

        for _, b in ipairs(tabList:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                b.TextColor3 = Color3.fromRGB(220, 220, 220)
            end
        end
        btn.BackgroundColor3 = Color3.fromRGB(100, 149, 237)
        btn.TextColor3 = Color3.new(1, 1, 1)
    end)

    return btn, page
end

