local function createSlider(tab, text, min, max, default, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, TouchEnabled and 70 or 60)
    container.BackgroundTransparency = 1
    container.Parent = tab

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, TouchEnabled and 50 or 45)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    frame.Parent = container
    createCorner(frame, TouchEnabled and 8 or 4)
    createStroke(frame)

    local button = Instance.new("Frame")
    button.Size = UDim2.new(1, -12, 1, 0)
    button.Position = UDim2.new(0, 6, 0.5, 0)
    button.AnchorPoint = Vector2.new(0, 0.5)
    button.BackgroundTransparency = 1
    button.Parent = container

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, TouchEnabled and 22 or 18)
    title.Position = UDim2.new(0, 5, 0, TouchEnabled and 8 or 5)
    title.Text = text
    title.Font = TouchEnabled and Enum.Font.GothamBold or Enum.Font.SourceSansBold
    title.TextSize = TouchEnabled and 15 or 14
    title.TextColor3 = Color3.new(1, 1, 1)
    title.BackgroundTransparency = 1
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = button

    local valueText = title:Clone()
    valueText.Size = UDim2.new(1, 0, 0, TouchEnabled and 22 or 18)
    valueText.Position = UDim2.new(0.5, 0, 0, TouchEnabled and 8 or 5)
    valueText.TextXAlignment = Enum.TextXAlignment.Center
    valueText.Parent = button

    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.8, 0, 0, TouchEnabled and 8 or 6)
    slider.Position = UDim2.new(0, 5, 1, TouchEnabled and -25 or -15)
    slider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    slider.Parent = frame
    createCorner(slider, TouchEnabled and 4 or 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, ((default-min)/(max-min))*(TouchEnabled and 80*0.8 or 80*0.8), 0, TouchEnabled and 8 or 6)
    fill.Position = UDim2.new(0, 0, 0, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 149, 237)
    fill.Parent = slider
    createCorner(fill, TouchEnabled and 4 or 3)

    local dragging = false
    local function update(pos)
        local rel = math.clamp((pos.X - slider.AbsolutePosition.X)/slider.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max-min)*rel)
        fill.Size = UDim2.new(0, rel*slider.AbsoluteSize.X, 0, TouchEnabled and 8 or 6)
        valueText.Text = tostring(val)
        callback(val)
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            update(input.Position)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return slider
end

local function createButton(tab, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, TouchEnabled and 50 or 40)
    btn.Text = text
    btn.Font = TouchEnabled and Enum.Font.GothamBold or Enum.Font.SourceSansBold
    btn.TextSize = TouchEnabled and 16 or 14
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.BackgroundColor3 = Color3.fromRGB(30, 120, 210)
    btn.Parent = tab
    createCorner(btn, TouchEnabled and 10 or 6)
    createStroke(btn)

    btn.MouseButton1Down:Connect(function()
        playClickEffect(btn)
        Callback(function()
            callback()
        end)
    end)

    return btn
end

