local function CreateSlider(Parent, Text, Min, Max, Default, Callback)
local Container = Instance.new("Frame")
Container.Size = UDim2.new(1, 0, 0, 50)
Container.BackgroundTransparency = 1
Container.Parent = Parent

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(1, 0, 0, 40)
Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
Frame.Parent = Container
Instance.new("UICorner").Parent = Frame

local Label = Instance.new("TextLabel")
Label.Size = UDim2.new(1, -10, 0, 20)
Label.Position = UDim2.new(0, 10, 0, 5)
Label.BackgroundTransparency= 1
Label.BackgroundTransparency = 1
Label.Text = Text..": "..tostring(Default)
Label.TextColor3 = Color3.new(1, 1, 1)
Label.Font = Enum.Font.Gotham
Label.TextSize = 14
Label.TextXAlignment = Enum.TextXAlignment.Left
Label.Parent = Frame

local Rail = Instance.new("Frame")
Rail.Size = UDim2.new(1, -20, 0, 6)
Rail.Position = UDim2.new(0, 10, 1, -12)
Rail.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
Rail.Parent = Frame
Instance.new("UICorner").Parent = Rail

local Fill = Instance.new("Frame")
Fill.Size = UDim2.new((Default-Min)/(Max-Min), 0, 1, 0)
Fill.BackgroundColor3 = Color3.fromRGB(100, 149, 237)
Fill.Parent = Rail
Instance.new("UICorner").Parent = Fill

local DraggingSlider = false
local function Update(InputPos)
local Rel = math.clamp((InputPos.X - Rail.AbsolutePosition.X) / Rail.AbsoluteSize.X, 0, 1)
local Val = math.floor(Min + (Max - Min)  Rel)
Fill.Size = UDim2.new(Rel, 0, 1, 0)
Label.Text = Text..": "..tostring(Val)
Callback(Val)
end

Rail.InputBegan:Connect(function(Input)
if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
DraggingSlider = true
Update(Input.Position)
end
end)

UserInputService.InputChanged:Connect(function(Input)
if DraggingSlider and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
Update(Input.Position)
end
end)

UserInputService.InputEnded:Connect(function(Input)
if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
DraggingSlider = false
end
end)
end

-- Tabs
local MovTab = CreateTab("Move")
local VisTab = CreateTab("Visual")
local MiscTab = CreateTab("Misc")

-- Movement
CreateToggle(MovTab, "Fly", false, function(v)
states.Fly = v
local Char = GetChar()
local HRP = GetHRP()
if v and HRP then
local BG = Instance.new("BodyGyro", HRP)
BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
local BV = Instance.new("BodyVelocity", HRP)
BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
states.FlyConn = RunService.Heartbeat:Connect(function()
if not states.Fly then return end
local Move = UserInputService:GetMouseLocation()
BV.Velocity = Vector3.new(0, 50, 0)
BG.CFrame = Workspace.CurrentCamera.CFrame
end)
else
if states.FlyConn then states.FlyConn:Disconnect() end
if Char then
for _, v in ipairs(Char:GetDescendants()) do
if v:IsA("BodyGyro") or v:IsA("BodyVelocity") then v:Destroy() end
end
end
end
end)

CreateSlider(MovTab, "WalkSpeed", 16, 200, 16, function(v)
states.WalkSpeed = v
local H = GetHum()
if H then H.WalkSpeed = v end
end)

CreateToggle(MovTab, "NoClip", false, function(v)
states.Noclip = v
if v then
states.NoclipConn = RunService.Heartbeat:Connect(function()
local Char = GetChar()
if Char then
for _, v in ipairs(Char:GetDescendants()) do
if v:IsA("BasePart") then v.CanCollide = false end
end
end
end)
else
if states.NoclipConn then states.NoclipConn:Disconnect() end
end
end)

-- Visual
CreateToggle(VisTab, "FullBright", false, function(v)
if v then
Lighting.Brightness = 4
Lighting.ClockTime = 14
Lighting.FogEnd = 100000
else
Lighting.Brightness = 1.5
Lighting.FogEnd = 500
end
end)

-- Misc
CreateToggle(MiscTab, "Auto Farm", false, function(v)
states.AutoFarm = v
if v then
states.FarmConn = RunService.Heartbeat:Connect(function()
local HRP = GetHRP()
if not HRP then return end
local H = GetHum()
if H then
H:Move(Vector3.new(0, 0, -1))
end
end)
else
if states.FarmConn then states.FarmConn:Disconnect() end
local H = GetHum()
if H then H:Move(Vector3.new(0, 0, 0)) end
end
end)
